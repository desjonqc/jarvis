# Copy to .env (setup.sh does it and generates the API key).

# ---- Web app accounts
# Account created at the first start, when none exists yet (setup.sh generates the password).
# Once created, the password can be removed from here : it is stored hashed in data/Auth/users.json.
# Add an account or reset a password : docker compose run --rm jarvis user <name>
JARVIS_ADMIN_USER=admin
JARVIS_ADMIN_PASSWORD=
# Lifetime without use of a "stay logged in" session (days)
JARVIS_SESSION_DAYS=30
# true when the web app is served over HTTPS (the session cookie is then never sent over plain HTTP)
JARVIS_COOKIE_SECURE=false

# API keys for scripts, accepted in the "apikey" header, comma separated (the web app uses its session instead).
# Generate one with : openssl rand -hex 24
JARVIS_API_KEYS=

# ---- Radio (nRF24L01+ on the GPIO header). Channel, data rate and network id must match the firmware.
# nrf24 = real radio ; simulated = no hardware (development : node 2 relay, node 3 button, /sim/press?id=3)
JARVIS_RADIO_DRIVER=nrf24
# 0..83 (EU 2.4 GHz band). Choose a free one : docker compose run --rm jarvis scan
JARVIS_RADIO_CHANNEL=76
# 250KBPS (best range, needs nRF24L01+ everywhere), 1MBPS or 2MBPS
JARVIS_RADIO_DATA_RATE=250KBPS
# MIN, LOW, HIGH or MAX
JARVIS_RADIO_PA_LEVEL=MAX
# 4 upper bytes of every radio address (hex)
JARVIS_RADIO_NETWORK_ID=4A52564E
# Wiring (BCM numbers) : CE on GPIO22 (pin 15), IRQ on GPIO24 (pin 18, -1 if not wired), CSN on CE0 (pin 24)
JARVIS_RADIO_CE_GPIO=22
JARVIS_RADIO_IRQ_GPIO=24
JARVIS_RADIO_SPI_BUS=0
JARVIS_RADIO_SPI_CS=0
JARVIS_RADIO_SPI_HZ=4000000

# Max wait (ms) for a module's answer to a web API command.
JARVIS_COMMAND_TIMEOUT_MS=12000
# Periodic save of the modules (ms), on top of the save at shutdown. 0 = disabled.
JARVIS_AUTOSAVE_INTERVAL_MS=300000

# "*" or the web app origin (e.g. http://jarvis.local). Not needed when the web app goes through Caddy (/api).
JARVIS_CORS_ORIGIN=*

TZ=Europe/Paris

# Published address of the direct API port. Set to 127.0.0.1:8000 once the web app only uses /api through Caddy.
JARVIS_API_PUBLISH=8000

# Groups of /dev/spidev0.0 and /dev/gpiochip0 on the host (filled by setup.sh)
SPI_GID=
GPIO_GID=
